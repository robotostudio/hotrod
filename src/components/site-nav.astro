---
import Lucide from './lucide.astro';

const links = [
  { label: 'Features', href: '/features' },
  { label: 'Services', href: '/services' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---
<header class="relative z-40 bg-primary text-primary-foreground">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="text-2xl font-black tracking-tight">HOTROD</a>
    <ul class="hidden md:flex items-center gap-8 font-bold">
      {links.map((link) => (
        <li>
          <a href={link.href} class="hover:underline underline-offset-4">{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="inline-flex items-center justify-center bg-primary-foreground text-primary font-bold px-4 py-2 hover:bg-primary-foreground/90 transition-colors"
      >
        Book Now
      </a>
      <details class="group md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border-4 border-primary-foreground [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Lucide name="menu" class="w-6 h-6 group-open:hidden" />
          <Lucide name="x" class="w-6 h-6 hidden group-open:block" />
        </summary>
        <ul class="absolute inset-x-0 top-full flex flex-col bg-primary text-primary-foreground border-t-4 border-primary-foreground px-6 py-4 font-bold text-xl">
          {links.map((link) => (
            <li>
              <a href={link.href} class="block py-3 hover:underline underline-offset-4">{link.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>
