---
import BaseLayout from '../../layouts/base-layout.astro';
import CheckerboardDivider from '../../components/checkerboard-divider.astro';
import Lucide from '../../components/lucide.astro';
import { getPublishedEvents } from '../../lib/content';
import { formatEventDay } from '../../lib/format-event-date';

const events = await getPublishedEvents();
---

<BaseLayout
  title="Events"
  description="Conferences, meetups, and street-level walkthroughs about taxi ranks across New York City. Meet drivers, fleet operators, and the people who plan the curb."
>
  <section class="bg-background text-foreground py-20 px-6">
    <div class="mx-auto max-w-7xl text-center">
      <h1 class="text-6xl md:text-7xl font-black mb-4 tracking-tight">EVENTS</h1>
      <p class="text-xl md:text-2xl font-semibold max-w-2xl mx-auto">
        Where New York&apos;s taxi rank community gets together.
      </p>
    </div>
  </section>

  <CheckerboardDivider />

  <section class="bg-foreground text-background py-20 px-6">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-center gap-4 mb-12">
        <span class="bg-background text-foreground px-4 py-2 font-black text-sm">UPCOMING</span>
        <div class="h-1 flex-1 bg-background" />
      </div>
      {events.length === 0 ? (
        <p class="font-semibold">No events scheduled yet.</p>
      ) : (
        <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {events.map((event) => (
            <li>
              <a
                href={`/events/${event.id}`}
                class="flex flex-col bg-background text-foreground border-4 border-background hover:border-white transition-colors p-6 h-full"
              >
                <span class="inline-block bg-foreground text-background px-3 py-1 font-bold text-xs mb-4 self-start">
                  {event.data.location.borough.toUpperCase()}
                </span>
                <h2 class="text-xl font-black mb-3 tracking-tight">{event.data.title.toUpperCase()}</h2>
                <p class="font-medium opacity-90 mb-4">{event.data.description}</p>
                <div class="mt-auto flex flex-col gap-2 text-xs font-bold opacity-80 mb-4">
                  <span class="flex items-center gap-1">
                    <Lucide name="calendar" class="w-3 h-3" />
                    {formatEventDay(event.data.startDate, event.data.endDate)}
                  </span>
                  <span class="flex items-center gap-1">
                    <Lucide name="map-pin" class="w-3 h-3" />
                    {event.data.location.venue}
                  </span>
                </div>
                <span class="flex items-center gap-2 font-black text-sm">
                  VIEW EVENT <Lucide name="arrow-right" class="w-4 h-4" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <CheckerboardDivider />
</BaseLayout>
