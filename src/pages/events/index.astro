---
import BaseLayout from '../../layouts/base-layout.astro';
import Lucide from '../../components/lucide.astro';
import { getPublishedEvents } from '../../lib/content';

const events = await getPublishedEvents();
---

<BaseLayout
  title="Events"
  description="Conferences, meetups and workshops about New York taxi ranks: where the city's drivers, planners and riders get together to talk about the curb."
>
  <section class="bg-background text-foreground py-20 px-6">
    <div class="mx-auto max-w-7xl text-center">
      <h1 class="text-6xl md:text-7xl font-black mb-4 tracking-tight">EVENTS</h1>
      <p class="text-xl md:text-2xl font-semibold max-w-2xl mx-auto">
        Where New York talks taxi ranks.
      </p>
    </div>
  </section>

  <section class="bg-background text-foreground pb-20 px-6">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-center gap-4 mb-12">
        <span class="bg-foreground text-background px-4 py-2 font-black text-sm">
          UPCOMING EVENTS
        </span>
        <div class="h-1 flex-1 bg-foreground" />
      </div>
      {events.length === 0 ? (
        <p class="font-semibold">No events yet.</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {events.map((event) => (
            <a
              href={`/events/${event.id}`}
              class="block bg-foreground text-background border-4 border-foreground hover:border-white transition-colors p-6 h-full"
            >
              <span class="inline-flex items-center gap-2 bg-background text-foreground px-3 py-1 font-bold text-xs mb-4">
                <Lucide name="map-pin" class="w-3 h-3" />
                {event.data.location.toUpperCase()}
              </span>
              <h3 class="text-xl font-black mb-3 tracking-tight">
                {event.data.title.toUpperCase()}
              </h3>
              <p class="font-medium opacity-90 mb-4">{event.data.description}</p>
              <div class="flex items-center gap-2 font-black text-sm">
                VIEW EVENT <Lucide name="arrow-right" class="w-4 h-4" />
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
